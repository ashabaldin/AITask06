#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НачалоПериода = НачалоГода(ТекущаяДатаСеанса());
	КонецПериода = КонецГода(ТекущаяДатаСеанса());
	Файл = КаталогВременныхФайлов() + "invoices.json";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.ПолноеИмяФайла = Файл;
	Диалог.Показать(Новый ОписаниеОповещения("ФайлНачалоВыбораЗавершение", ЭтотОбъект));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если Не ЗначениеЗаполнено(Файл) Тогда
		ПоказатьПредупреждение(, "Укажите файл выгрузки.");
		Возврат;
	КонецЕсли;
	Количество = 0;
	Текст = Новый ТекстовыйДокумент;
	Текст.УстановитьТекст(СформироватьJSON(Количество));
	Текст.НачатьЗапись(Новый ОписаниеОповещения("ВыгрузитьЗавершение", ЭтотОбъект, Количество),
		Файл, КодировкаТекста.UTF8);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ФайлНачалоВыбораЗавершение(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт
	Если ВыбранныеФайлы <> Неопределено И ВыбранныеФайлы.Количество() > 0 Тогда
		Файл = ВыбранныеФайлы[0];
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьЗавершение(Результат, Количество) Экспорт
	Если Результат = Истина Тогда
		Состояние = СтрШаблон("Выгружено счетов: %1", Количество);
		ПоказатьОповещениеПользователя("Выгрузка счетов", , Состояние);
		Сообщить(Состояние);
	Иначе
		Сообщить("Не удалось записать файл " + Файл);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СформироватьJSON(Количество)
	Текст = осч_ВыгрузкаСчетов.ВыгрузитьВJSON(НачалоДня(НачалоПериода), КонецДня(КонецПериода), Организация);
	Количество = СтрЧислоВхождений(Текст, """number""");
	Возврат Текст;
КонецФункции

#КонецОбласти
