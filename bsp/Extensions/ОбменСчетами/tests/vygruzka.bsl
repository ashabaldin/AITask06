// Тест: осч_ВыгрузкаСчетов.ВыгрузитьВJSON формирует файл по формату спеки.
Ошибки = Новый Массив;
Текст = осч_ВыгрузкаСчетов.ВыгрузитьВJSON(Дата(2010, 1, 1), Дата(2015, 12, 31, 23, 59, 59), Неопределено);
Чтение = Новый ЧтениеJSON; Чтение.УстановитьСтроку(Текст); Д = ПрочитатьJSON(Чтение, Истина);
Если Д["format"] <> "bsp-invoices" Тогда Ошибки.Добавить("format=" + Д["format"]); КонецЕсли;
Если Д["version"] <> 1 Тогда Ошибки.Добавить("version"); КонецЕсли;
Если Д["invoices"].Количество() <> 9 Тогда Ошибки.Добавить("invoices=" + Д["invoices"].Количество()); КонецЕсли;
С = Неопределено;
Для Каждого Э Из Д["invoices"] Цикл Если Э["id"] = "db9af9b9-09db-11e0-915d-e0cb4ed5f627" Тогда С = Э; КонецЕсли; КонецЦикла;
Если С = Неопределено Тогда Ошибки.Добавить("нет счета НТ-00000002");
Иначе
 Если С["number"] <> "НТ-00000002" Тогда Ошибки.Добавить("number=" + С["number"]); КонецЕсли;
 Если С["date"] <> "2010-12-17T15:49:05" Тогда Ошибки.Добавить("date=" + С["date"]); КонецЕсли;
 Если С["deleted"] <> Ложь Тогда Ошибки.Добавить("deleted"); КонецЕсли;
 Если С["organization"]["name"] <> "Новые технологии ООО" Тогда Ошибки.Добавить("org=" + С["organization"]["name"]); КонецЕсли;
 Если С["customer"]["name"] <> "ООО ""Альфа""" Тогда Ошибки.Добавить("customer=" + С["customer"]["name"]); КонецЕсли;
 Если С["currency"]["code"] <> "643" Тогда Ошибки.Добавить("currency.code"); КонецЕсли;
 Если С["amount"] <> 20000 Тогда Ошибки.Добавить("amount=" + С["amount"]); КонецЕсли;
 Если С["goods"].Количество() <> 2 Тогда Ошибки.Добавить("goods=" + С["goods"].Количество());
 Иначе
  Г = С["goods"][0];
  Если Г["lineNo"] <> 1 Или Г["quantity"] <> 1 Или Г["price"] <> 15000 Или Г["sum"] <> 15000 Тогда Ошибки.Добавить("строка 1"); КонецЕсли;
  Если СтрДлина(Г["item"]["id"]) <> 36 Или Г["item"]["name"] <> "1С:Зарплата и Управление Персоналом 8" Тогда Ошибки.Добавить("item"); КонецЕсли;
  Если Г["item"].Получить("article") = Неопределено Тогда Ошибки.Добавить("article"); КонецЕсли;
 КонецЕсли;
КонецЕсли;
// Отбор по организации
Т2 = осч_ВыгрузкаСчетов.ВыгрузитьВJSON(Дата(2010, 1, 1), Дата(2015, 12, 31), Справочники._ДемоОрганизации.НайтиПоНаименованию("Перспектива ЗАО"));
Ч2 = Новый ЧтениеJSON; Ч2.УстановитьСтроку(Т2); Д2 = ПрочитатьJSON(Ч2, Истина);
Если Д2["invoices"].Количество() <> 4 Тогда Ошибки.Добавить("отбор по организации=" + Д2["invoices"].Количество()); КонецЕсли;
Результат = ?(Ошибки.Количество() = 0, "OK", СтрСоединить(Ошибки, "; "));
