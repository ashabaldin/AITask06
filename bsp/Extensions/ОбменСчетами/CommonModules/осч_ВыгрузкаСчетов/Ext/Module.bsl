#Область ПрограммныйИнтерфейс

// Формирует JSON-снимок счетов на оплату покупателю для загрузки в демо УФ.
// Формат описан в docs/superpowers/specs/2026-11-06-invoice-order-exchange-design.md.
// Выгружаются все счета периода, включая помеченные на удаление (признак deleted).
//
// Параметры:
//   ДатаНачала    - Дата - начало периода (включительно);
//   ДатаОкончания - Дата - окончание периода (включительно);
//   Организация   - СправочникСсылка._ДемоОрганизации, Неопределено - необязательный отбор.
//
// Возвращаемое значение:
//   Строка - JSON в кодировке UTF-8 (строка).
//
Функция ВыгрузитьВJSON(ДатаНачала, ДатаОкончания, Организация = Неопределено) Экспорт
	
	Счета = Новый Массив;
	Выборка = ВыборкаСчетов(ДатаНачала, ДатаОкончания, Организация);
	Пока Выборка.Следующий() Цикл
		Счета.Добавить(ОписаниеСчета(Выборка));
	КонецЦикла;
	
	Данные = Новый Структура;
	Данные.Вставить("format", "bsp-invoices");
	Данные.Вставить("version", 1);
	Данные.Вставить("createdAt", XMLСтрока(ТекущаяДатаСеанса()));
	Данные.Вставить("invoices", Счета);
	
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(, Символы.Таб));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыборкаСчетов(ДатаНачала, ДатаОкончания, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Счет.Ссылка КАК Ссылка,
	|	Счет.Номер КАК Номер,
	|	Счет.Дата КАК Дата,
	|	Счет.ПометкаУдаления КАК ПометкаУдаления,
	|	Счет.Организация КАК Организация,
	|	Счет.Организация.Наименование КАК ОрганизацияНаименование,
	|	Счет.Контрагент КАК Контрагент,
	|	Счет.Контрагент.Наименование КАК КонтрагентНаименование,
	|	Счет.ВалютаДокумента КАК Валюта,
	|	Счет.ВалютаДокумента.Код КАК ВалютаКод,
	|	Счет.ВалютаДокумента.Наименование КАК ВалютаНаименование,
	|	Счет.СуммаОплаты КАК Сумма,
	|	Счет.Товары.(
	|		НомерСтроки КАК НомерСтроки,
	|		Номенклатура КАК Номенклатура,
	|		Номенклатура.Наименование КАК НоменклатураНаименование,
	|		Номенклатура.Артикул КАК НоменклатураАртикул,
	|		Количество КАК Количество,
	|		Цена КАК Цена,
	|		Сумма КАК Сумма
	|	) КАК Товары
	|ИЗ
	|	Документ._ДемоСчетНаОплатуПокупателю КАК Счет
	|ГДЕ
	|	Счет.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И (&БезОтбораОрганизации ИЛИ Счет.Организация = &Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счет.Дата";
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);
	Запрос.УстановитьПараметр("БезОтбораОрганизации", Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организация", Организация);
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции

Функция ОписаниеСчета(Выборка)
	
	Товары = Новый Массив;
	ВыборкаТоваров = Выборка.Товары.Выбрать();
	Пока ВыборкаТоваров.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("lineNo", ВыборкаТоваров.НомерСтроки);
		Строка.Вставить("item", ОписаниеОбъекта(ВыборкаТоваров.Номенклатура,
			ВыборкаТоваров.НоменклатураНаименование, "article", ВыборкаТоваров.НоменклатураАртикул));
		Строка.Вставить("quantity", ВыборкаТоваров.Количество);
		Строка.Вставить("price", ВыборкаТоваров.Цена);
		Строка.Вставить("sum", ВыборкаТоваров.Сумма);
		Товары.Добавить(Строка);
	КонецЦикла;
	
	Счет = Новый Структура;
	Счет.Вставить("id", Идентификатор(Выборка.Ссылка));
	Счет.Вставить("number", Выборка.Номер);
	Счет.Вставить("date", XMLСтрока(Выборка.Дата));
	Счет.Вставить("deleted", Выборка.ПометкаУдаления);
	Счет.Вставить("organization", ОписаниеОбъекта(Выборка.Организация, Выборка.ОрганизацияНаименование));
	Счет.Вставить("customer", ОписаниеОбъекта(Выборка.Контрагент, Выборка.КонтрагентНаименование));
	Счет.Вставить("currency", ОписаниеОбъекта(Выборка.Валюта, Выборка.ВалютаНаименование, "code", Выборка.ВалютаКод));
	Счет.Вставить("amount", Выборка.Сумма);
	Счет.Вставить("goods", Товары);
	Возврат Счет;
	
КонецФункции

// Ключ сопоставления объекта: UUID и наименование, плюс необязательное дополнительное поле.
Функция ОписаниеОбъекта(Ссылка, Наименование, ИмяДопПоля = "", ЗначениеДопПоля = "")
	
	Описание = Новый Структура("id, name", Идентификатор(Ссылка), Строка(Наименование));
	Если ЗначениеЗаполнено(ИмяДопПоля) Тогда
		Описание.Вставить(ИмяДопПоля, СокрЛП(ЗначениеДопПоля));
	КонецЕсли;
	Возврат Описание;
	
КонецФункции

Функция Идентификатор(Ссылка)
	Возврат ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка.УникальныйИдентификатор()), "");
КонецФункции

#КонецОбласти
