// Служебный запускатель кода BSL для проверок и разведки данных (не входит в поставку).
// Запуск: 1cv8c.exe ENTERPRISE /F<база> /Execute ЗапускBSL.epf /C"<файл.bsl>;<файл-результата>"
// Код в файле выполняется на сервере и должен присвоить строку переменной Результат.

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Части = СтрРазделить(ПараметрЗапуска, ";");
	Если Части.Количество() = 2 Тогда
		ВыполнитьФайл(Части[0], Части[1]);
	КонецЕсли;
	ЗавершитьРаботуСистемы(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ВыполнитьФайл(ИмяФайлаКода, ИмяФайлаРезультата)
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайлаКода, КодировкаТекста.UTF8);
	Результат = "";
	Попытка
		Выполнить(Текст.ПолучитьТекст());
	Исключение
		Результат = "ОШИБКА: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Вывод = Новый ТекстовыйДокумент;
	Вывод.УстановитьТекст(Строка(Результат));
	Вывод.Записать(ИмяФайлаРезультата, КодировкаТекста.UTF8);
КонецПроцедуры

#КонецОбласти
