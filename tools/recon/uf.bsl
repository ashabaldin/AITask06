М = Новый Массив;
Для Каждого Имя Из СтрРазделить("Организации,Контрагенты,Валюты,Склады,ВидыЦен", ",") Цикл
 З = Новый Запрос("ВЫБРАТЬ Наименование, ПометкаУдаления КАК ПУ ИЗ Справочник." + Имя + ?(Метаданные.Справочники[Имя].Иерархический, " ГДЕ НЕ ЭтоГруппа", ""));
 М.Добавить("== " + Имя + ": " + СтрСоединить(З.Выполнить().Выгрузить().ВыгрузитьКолонку("Наименование"), " | "));
КонецЦикла;
З = Новый Запрос("ВЫБРАТЬ Наименование, Артикул ИЗ Справочник.Товары ГДЕ НЕ ЭтоГруппа");
В = З.Выполнить().Выбрать(); Т = Новый Массив;
Пока В.Следующий() Цикл Т.Добавить(В.Наименование + " [" + В.Артикул + "]"); КонецЦикла;
М.Добавить("== Товары: " + СтрСоединить(Т, " | "));
ЗЗ = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.Заказ"); М.Добавить("== Заказов: " + ЗЗ.Выполнить().Выгрузить()[0].К);
Результат = СтрСоединить(М, Символы.ПС);
