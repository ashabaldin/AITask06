Запрос = Новый Запрос("ВЫБРАТЬ С.Ссылка, С.Номер, С.Дата, С.ПометкаУдаления КАК ПУ, С.Проведен,
|ПРЕДСТАВЛЕНИЕ(С.Организация) КАК Орг, ПРЕДСТАВЛЕНИЕ(С.Контрагент) КАК Кон, С.ВалютаДокумента.Наименование КАК Вал, С.ВалютаДокумента.Код КАК Код,
|С.Товары.(НомерСтроки, ПРЕДСТАВЛЕНИЕ(Номенклатура) КАК Ном, Номенклатура.Артикул КАК Арт, Количество, Цена, Сумма)
|ИЗ Документ._ДемоСчетНаОплатуПокупателю КАК С УПОРЯДОЧИТЬ ПО С.Дата");
В = Запрос.Выполнить().Выбрать(); М = Новый Массив;
Пока В.Следующий() Цикл
 М.Добавить(СтрШаблон("%1 %2 ПУ=%3 Пр=%4 | %5 | %6 | %7(%8) | %9", В.Номер, В.Дата, В.ПУ, В.Проведен, В.Орг, В.Кон, В.Вал, В.Код, В.Ссылка.УникальныйИдентификатор()));
 Т = В.Товары.Выбрать();
 Пока Т.Следующий() Цикл М.Добавить(СтрШаблон("    %1. %2 [%3] %4 x %5 = %6", Т.НомерСтроки, Т.Ном, Т.Арт, Т.Количество, Т.Цена, Т.Сумма)); КонецЦикла;
КонецЦикла;
Результат = СтрСоединить(М, Символы.ПС);
