#Область ПрограммныйИнтерфейс

// Находит объект УФ, соответствующий объекту БСП из файла обмена.
// Порядок: регистр соответствий по UUID БСП, затем автоподбор
// (товар — по артикулу, затем по наименованию; остальные — по наименованию).
// Найденный автоподбором единственный объект запоминается в регистре.
//
// Параметры:
//   ТипОбъекта - Строка - "Организация", "Контрагент", "Валюта", "Номенклатура";
//   Данные     - Соответствие - описание объекта из файла: "id", "name", для товара "article".
//
// Возвращаемое значение:
//   Структура - Ссылка (ЛюбаяСсылка, Неопределено), Ошибка (Строка, пусто при успехе).
//
Функция НайтиСсылку(ТипОбъекта, Данные) Экспорт
	
	Идентификатор = Строка(Данные.Получить("id"));
	Наименование = Строка(Данные.Получить("name"));
	
	Ссылка = СсылкаПоИдентификатору(ТипОбъекта, Идентификатор);
	Если Ссылка <> Неопределено Тогда
		Возврат Результат(Ссылка);
	КонецЕсли;
	
	Кандидаты = Новый Массив;
	Артикул = СокрЛП(Данные.Получить("article"));
	Если ТипОбъекта = "Номенклатура" И ЗначениеЗаполнено(Артикул) Тогда
		Кандидаты = Кандидаты(ТипОбъекта, "Артикул", Артикул);
	КонецЕсли;
	Если Кандидаты.Количество() = 0 Тогда
		Кандидаты = Кандидаты(ТипОбъекта, "Наименование", Наименование);
	КонецЕсли;
	
	Если Кандидаты.Количество() = 1 Тогда
		ЗаписатьСоответствие(ТипОбъекта, Идентификатор, Кандидаты[0], Наименование);
		Возврат Результат(Кандидаты[0]);
	КонецЕсли;
	
	Причина = ?(Кандидаты.Количество() = 0, "не найден", "неоднозначно (найдено несколько)");
	Возврат Результат(Неопределено, СтрШаблон("%1: %2 ""%3"". Задайте соответствие в регистре «Соответствия объектов БСП».",
		Причина, ТипОбъекта, Наименование));
	
КонецФункции

// Возвращает объект УФ, сохраненный в регистре для UUID объекта БСП.
//
// Параметры:
//   ТипОбъекта       - Строка - тип объекта БСП (см. НайтиСсылку, а также "СчетНаОплату");
//   ИдентификаторБСП - Строка - UUID объекта БСП.
//
// Возвращаемое значение:
//   ЛюбаяСсылка, Неопределено - найденная ссылка.
//
Функция СсылкаПоИдентификатору(ТипОбъекта, ИдентификаторБСП) Экспорт
	
	Запись = РегистрыСведений.зсб_СоответствияОбъектовБСП.СоздатьМенеджерЗаписи();
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ИдентификаторБСП = ИдентификаторБСП;
	Запись.Прочитать();
	Возврат ?(Запись.Выбран() И ЗначениеЗаполнено(Запись.Ссылка), Запись.Ссылка, Неопределено);
	
КонецФункции

// Сохраняет соответствие объекта БСП объекту УФ.
//
// Параметры:
//   ТипОбъекта       - Строка - тип объекта БСП;
//   ИдентификаторБСП - Строка - UUID объекта БСП;
//   Ссылка           - ЛюбаяСсылка - объект УФ;
//   Представление    - Строка - наименование или номер объекта в БСП.
//
Процедура ЗаписатьСоответствие(ТипОбъекта, ИдентификаторБСП, Ссылка, Представление) Экспорт
	
	Запись = РегистрыСведений.зсб_СоответствияОбъектовБСП.СоздатьМенеджерЗаписи();
	Запись.ТипОбъекта = ТипОбъекта;
	Запись.ИдентификаторБСП = ИдентификаторБСП;
	Запись.Ссылка = Ссылка;
	Запись.Представление = Представление;
	Запись.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Кандидаты(ТипОбъекта, ИмяПоля, Значение)
	
	ИмяСправочника = ИменаСправочников().Получить(ТипОбъекта);
	Если ИмяСправочника = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Неизвестный тип объекта БСП: %1", ТипОбъекта);
	КонецЕсли;
	
	Условия = Новый Массив;
	Условия.Добавить("НЕ Спр.ПометкаУдаления");
	Условия.Добавить("Спр." + ИмяПоля + " = &Значение");
	Если Метаданные.Справочники[ИмяСправочника].Иерархический Тогда
		Условия.Добавить("НЕ Спр.ЭтоГруппа");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = СтрШаблон("ВЫБРАТЬ ПЕРВЫЕ 2 Спр.Ссылка КАК Ссылка ИЗ Справочник.%1 КАК Спр ГДЕ %2",
		ИмяСправочника, СтрСоединить(Условия, " И "));
	Запрос.УстановитьПараметр("Значение", Значение);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции

Функция ИменаСправочников()
	
	Имена = Новый Соответствие;
	Имена.Вставить("Организация", "Организации");
	Имена.Вставить("Контрагент", "Контрагенты");
	Имена.Вставить("Валюта", "Валюты");
	Имена.Вставить("Номенклатура", "Товары");
	Возврат Имена;
	
КонецФункции

Функция Результат(Ссылка, Ошибка = "")
	Возврат Новый Структура("Ссылка, Ошибка", Ссылка, Ошибка);
КонецФункции

#КонецОбласти
