#Область ПрограммныйИнтерфейс

// Загружает счета на оплату из файла обмена БСП в документы «Заказ».
// Каждый счет загружается в своей транзакции: ошибка одного счета не мешает остальным.
// Заказ ищется по регистру соответствий (тип "СчетНаОплату"), поэтому повторная загрузка
// обновляет тот же заказ. Заказы только записываются, не проводятся.
//
// Параметры:
//   Текст - Строка - содержимое JSON-файла формата bsp-invoices версии 1.
//
// Возвращаемое значение:
//   Структура - Загружено, Обновлено, Пропущено (Число), Протокол (Массив из Строка).
//
Функция ЗагрузитьИзJSON(Текст) Экспорт
	
	Итог = Новый Структура("Загружено, Обновлено, Пропущено, Протокол", 0, 0, 0, Новый Массив);
	
	Данные = ПрочитатьФайлОбмена(Текст);
	Если Данные = Неопределено Тогда
		Итог.Протокол.Добавить("Неверный формат файла: ожидается JSON bsp-invoices версии 1.");
		Возврат Итог;
	КонецЕсли;
	
	Для Каждого Счет Из Данные["invoices"] Цикл
		ЗагрузитьСчет(Счет, Итог);
	КонецЦикла;
	
	Возврат Итог;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьФайлОбмена(Текст)
	
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТипЗнч(Данные) <> Тип("Соответствие")
		Или Данные["format"] <> "bsp-invoices"
		Или Данные["version"] <> 1
		Или ТипЗнч(Данные["invoices"]) <> Тип("Массив") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Данные;
	
КонецФункции

Процедура ЗагрузитьСчет(Счет, Итог)
	
	Представление = СтрШаблон("Счет %1 от %2", Счет["number"], Формат(ДатаИзJSON(Счет["date"]), "ДЛФ=D"));
	
	НачатьТранзакцию();
	Попытка
		Результат = ЗаписатьЗаказ(Счет, Представление);
		Если ЗначениеЗаполнено(Результат.Ошибки) Тогда
			ОтменитьТранзакцию();
			Итог.Пропущено = Итог.Пропущено + 1;
			Итог.Протокол.Добавить(Представление + ": пропущен. " + Результат.Ошибки);
			Возврат;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Итог.Пропущено = Итог.Пропущено + 1;
		Итог.Протокол.Добавить(Представление + ": ошибка. " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	Итог[Результат.Действие] = Итог[Результат.Действие] + 1;
	Итог.Протокол.Добавить(Представление + ": " + Результат.Описание);
	
КонецПроцедуры

// Возвращает Структура: Действие ("Загружено", "Обновлено"), Описание, Ошибки (Строка; пусто при успехе).
Функция ЗаписатьЗаказ(Счет, Представление)
	
	Результат = Новый Структура("Действие, Описание, Ошибки", "Обновлено", "", "");
	Идентификатор = Строка(Счет["id"]);
	Заказ = зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", Идентификатор);
	
	Если Счет["deleted"] = Истина Тогда
		Если Заказ = Неопределено Тогда
			Результат.Ошибки = "Счет помечен на удаление в БСП, заказа в УФ нет.";
		Иначе
			Заказ.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
			Результат.Описание = СтрШаблон("заказ %1 помечен на удаление.", Заказ.Номер);
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	
	Ссылки = СопоставленныеСсылки(Счет);
	Если ЗначениеЗаполнено(Ссылки.Ошибки) Тогда
		Результат.Ошибки = СтрСоединить(Ссылки.Ошибки, " ");
		Возврат Результат;
	КонецЕсли;
	
	Если Заказ = Неопределено Тогда
		Объект = Документы.Заказ.СоздатьДокумент();
		Объект.Склад = СкладПоУмолчанию();
		Объект.СостояниеЗаказа = Перечисления.СостоянияЗаказов.Открыт;
		Результат.Действие = "Загружено";
	Иначе
		Объект = Заказ.ПолучитьОбъект();
		Объект.ПометкаУдаления = Ложь;
	КонецЕсли;
	
	Объект.Дата = ДатаИзJSON(Счет["date"]);
	Объект.Организация = Ссылки.Организация;
	Объект.Покупатель = Ссылки.Контрагент;
	Объект.Валюта = Ссылки.Валюта;
	Объект.ВидЦен = Ссылки.Контрагент.ВидЦен;
	Объект.Товары.Очистить();
	Для Каждого Строка Из Счет["goods"] Цикл
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Товар = Ссылки.Товары[Строка["lineNo"]];
		НоваяСтрока.Количество = Строка["quantity"];
		НоваяСтрока.Цена = Строка["price"];
		НоваяСтрока.Сумма = Строка["sum"];
	КонецЦикла;
	Объект.Записать(РежимЗаписиДокумента.Запись);
	
	зсб_СопоставлениеОбъектов.ЗаписатьСоответствие("СчетНаОплату", Идентификатор, Объект.Ссылка, Представление);
	Результат.Описание = СтрШаблон("%1 заказ %2.",
		?(Результат.Действие = "Загружено", "создан", "обновлен"), Объект.Номер);
	Возврат Результат;
	
КонецФункции

// Сопоставляет все ссылки счета и собирает все ошибки, а не только первую.
Функция СопоставленныеСсылки(Счет)
	
	Ссылки = Новый Структура("Организация, Контрагент, Валюта, Товары, Ошибки",
		, , , Новый Соответствие, Новый Массив);
	Поля = Новый Структура("Организация, Контрагент, Валюта", "organization", "customer", "currency");
	Для Каждого Поле Из Поля Цикл
		Ссылки[Поле.Ключ] = СсылкаИлиОшибка(Поле.Ключ, Счет[Поле.Значение], Ссылки.Ошибки);
	КонецЦикла;
	Для Каждого Строка Из Счет["goods"] Цикл
		Ссылки.Товары.Вставить(Строка["lineNo"], СсылкаИлиОшибка("Номенклатура", Строка["item"], Ссылки.Ошибки));
	КонецЦикла;
	Возврат Ссылки;
	
КонецФункции

Функция СсылкаИлиОшибка(ТипОбъекта, Данные, Ошибки)
	
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Ошибки.Добавить(СтрШаблон("Нет данных: %1.", ТипОбъекта));
		Возврат Неопределено;
	КонецЕсли;
	Найдено = зсб_СопоставлениеОбъектов.НайтиСсылку(ТипОбъекта, Данные);
	Если ЗначениеЗаполнено(Найдено.Ошибка) Тогда
		Ошибки.Добавить(Найдено.Ошибка);
	КонецЕсли;
	Возврат Найдено.Ссылка;
	
КонецФункции

Функция СкладПоУмолчанию()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Склады.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Склады КАК Склады
	|ГДЕ
	|	НЕ Склады.ПометкаУдаления
	|	И НЕ Склады.НеИспользовать
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склады.Код");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Нет доступного склада для нового заказа.";
	КонецЕсли;
	Возврат Выборка.Ссылка;
	
КонецФункции

Функция ДатаИзJSON(Значение)
	Возврат XMLЗначение(Тип("Дата"), Значение);
КонецФункции

#КонецОбласти
