#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Асинх Процедура ФайлНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "JSON (*.json)|*.json";
	Диалог.ПолноеИмяФайла = Файл;
	Выбранные = Ждать Диалог.ВыбратьАсинх();
	Если Выбранные <> Неопределено И Выбранные.Количество() > 0 Тогда
		Файл = Выбранные[0];
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Загрузить(Команда)
	Если Не ЗначениеЗаполнено(Файл) Тогда
		Протокол = "Укажите файл обмена.";
		Возврат;
	КонецЕсли;
	Текст = Новый ТекстовыйДокумент;
	Попытка
		Ждать Текст.ПрочитатьАсинх(Файл, КодировкаТекста.UTF8);
	Исключение
		Протокол = "Не удалось прочитать файл: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат;
	КонецПопытки;
	Протокол = ЗагрузитьНаСервере(Текст.ПолучитьТекст());
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСоответствия(Команда)
	ОткрытьФорму("РегистрСведений.зсб_СоответствияОбъектовБСП.ФормаСписка");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЗагрузитьНаСервере(Текст)
	Итог = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(Текст);
	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Загружено: %1, обновлено: %2, пропущено: %3",
		Итог.Загружено, Итог.Обновлено, Итог.Пропущено));
	Для Каждого Строка Из Итог.Протокол Цикл
		Строки.Добавить(Строка);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

#КонецОбласти
