// Тест: зсб_СопоставлениеОбъектов — поиск по регистру, автоподбор, неоднозначность, не найдено.
Ошибки = Новый Массив;
Ид1 = Строка(Новый УникальныйИдентификатор); Ид2 = Строка(Новый УникальныйИдентификатор);
Ид3 = Строка(Новый УникальныйИдентификатор); Ид4 = Строка(Новый УникальныйИдентификатор);
Дубли = Новый Массив;
Для Н = 1 По 2 Цикл Т = Справочники.Товары.СоздатьЭлемент(); Т.Наименование = "ЗСБ Дубль"; Т.Записать(); Дубли.Добавить(Т.Ссылка); КонецЦикла;
Попытка
	Хлеб = Справочники.Товары.НайтиПоРеквизиту("Артикул", "H987");
	// (а) автоподбор товара по артикулу и запись соответствия
	Д = Новый Соответствие; Д.Вставить("id", Ид1); Д.Вставить("name", "Нет такого имени"); Д.Вставить("article", "H987");
	Р = зсб_СопоставлениеОбъектов.НайтиСсылку("Номенклатура", Д);
	Если Р.Ссылка <> Хлеб Тогда Ошибки.Добавить("а: артикул не найден, " + Р.Ошибка); КонецЕсли;
	Если зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Номенклатура", Ид1) <> Хлеб Тогда Ошибки.Добавить("а: соответствие не записано"); КонецЕсли;
	// (б) повтор по тому же UUID с другими ключами — та же ссылка из регистра
	Д.Вставить("name", "Совсем другое"); Д.Вставить("article", "");
	Если зсб_СопоставлениеОбъектов.НайтиСсылку("Номенклатура", Д).Ссылка <> Хлеб Тогда Ошибки.Добавить("б: не из регистра"); КонецЕсли;
	// (в) неоднозначность по наименованию
	Д = Новый Соответствие; Д.Вставить("id", Ид2); Д.Вставить("name", "ЗСБ Дубль"); Д.Вставить("article", "");
	Р = зсб_СопоставлениеОбъектов.НайтиСсылку("Номенклатура", Д);
	Если Р.Ссылка <> Неопределено Или СтрНайти(Р.Ошибка, "неоднозначно") = 0 Тогда Ошибки.Добавить("в: " + Р.Ошибка); КонецЕсли;
	Если зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Номенклатура", Ид2) <> Неопределено Тогда Ошибки.Добавить("в: записано соответствие"); КонецЕсли;
	// (г) не найдено
	Д = Новый Соответствие; Д.Вставить("id", Ид3); Д.Вставить("name", "Нет такой организации");
	Р = зсб_СопоставлениеОбъектов.НайтиСсылку("Организация", Д);
	Если Р.Ссылка <> Неопределено Или СтрНайти(Р.Ошибка, "не найден") = 0 Тогда Ошибки.Добавить("г: " + Р.Ошибка); КонецЕсли;
	// (д) валюта по наименованию
	Д = Новый Соответствие; Д.Вставить("id", Ид4); Д.Вставить("name", "EUR"); Д.Вставить("code", "978");
	Если зсб_СопоставлениеОбъектов.НайтиСсылку("Валюта", Д).Ссылка <> Справочники.Валюты.НайтиПоНаименованию("EUR", Истина) Тогда Ошибки.Добавить("д: валюта"); КонецЕсли;
Исключение
	Ошибки.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
// Уборка тестовых данных
Для Каждого Ид Из СтрРазделить(Ид1 + "," + Ид2 + "," + Ид3 + "," + Ид4, ",") Цикл
	Для Каждого Тип Из СтрРазделить("Номенклатура,Организация,Валюта", ",") Цикл
		Попытка
			Н = РегистрыСведений.зсб_СоответствияОбъектовБСП.СоздатьНаборЗаписей();
			Н.Отбор.ТипОбъекта.Установить(Тип); Н.Отбор.ИдентификаторБСП.Установить(Ид); Н.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецЦикла;
Для Каждого Т Из Дубли Цикл Т.ПолучитьОбъект().Удалить(); КонецЦикла;
Результат = ?(Ошибки.Количество() = 0, "OK", СтрСоединить(Ошибки, "; "));
