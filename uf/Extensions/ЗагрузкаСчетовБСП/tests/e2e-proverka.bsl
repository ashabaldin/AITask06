// Проверка после сквозного обмена: по каждому непомеченному счету из файла есть ровно один заказ,
// он не проведен, шапка и товарные строки совпадают с файлом; общее число заказов = исходные 20 + 7.
Т = Новый ТекстовыйДокумент; Т.Прочитать("C:\Users\psi\aiwsis06\exchange\invoices.json", КодировкаТекста.UTF8);
Ч = Новый ЧтениеJSON; Ч.УстановитьСтроку(Т.ПолучитьТекст()); Д = ПрочитатьJSON(Ч, Истина);
Ошибки = Новый Массив; Проверено = 0;
Для Каждого С Из Д["invoices"] Цикл
	Заказ = зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", С["id"]);
	Если С["deleted"] Тогда
		Если Заказ <> Неопределено Тогда Ошибки.Добавить("загружен помеченный счет " + С["number"]); КонецЕсли;
		Продолжить;
	КонецЕсли;
	Если Заказ = Неопределено Тогда Ошибки.Добавить("нет заказа для " + С["number"]); Продолжить; КонецЕсли;
	Проверено = Проверено + 1;
	Если Заказ.Проведен Тогда Ошибки.Добавить(С["number"] + ": проведен"); КонецЕсли;
	Если Заказ.Дата <> XMLЗначение(Тип("Дата"), С["date"]) Тогда Ошибки.Добавить(С["number"] + ": дата"); КонецЕсли;
	Если Заказ.Организация <> зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Организация", С["organization"]["id"]) Тогда Ошибки.Добавить(С["number"] + ": организация"); КонецЕсли;
	Если Заказ.Покупатель <> зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Контрагент", С["customer"]["id"]) Тогда Ошибки.Добавить(С["number"] + ": покупатель"); КонецЕсли;
	Если Заказ.Валюта <> зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Валюта", С["currency"]["id"]) Тогда Ошибки.Добавить(С["number"] + ": валюта"); КонецЕсли;
	Если Заказ.Товары.Количество() <> С["goods"].Количество() Тогда Ошибки.Добавить(С["number"] + ": число строк"); Продолжить; КонецЕсли;
	Для Каждого Г Из С["goods"] Цикл
		Стр = Заказ.Товары[Г["lineNo"] - 1];
		Если Стр.Товар <> зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("Номенклатура", Г["item"]["id"]) Или Стр.Количество <> Г["quantity"] Или Стр.Цена <> Г["price"] Или Стр.Сумма <> Г["sum"] Тогда
			Ошибки.Добавить(С["number"] + ": строка " + Г["lineNo"]);
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ Документ.Заказ"); Всего = Запрос.Выполнить().Выгрузить()[0].К;
Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК К ИЗ РегистрСведений.зсб_СоответствияОбъектовБСП ГДЕ ТипОбъекта = ""СчетНаОплату"""); Связей = Запрос.Выполнить().Выгрузить()[0].К;
Если Проверено <> 7 Или Связей <> 7 Или Всего <> 27 Тогда Ошибки.Добавить(СтрШаблон("проверено=%1 связей=%2 заказов=%3", Проверено, Связей, Всего)); КонецЕсли;
Результат = ?(Ошибки.Количество() = 0, СтрШаблон("OK заказов проверено: %1, всего заказов: %2", Проверено, Всего), СтрСоединить(Ошибки, "; "));
