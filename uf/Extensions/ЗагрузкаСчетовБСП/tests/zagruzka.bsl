// Тест: зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON — создание, повтор без дублей, пропуск, формат, пустая ТЧ, пометка.
Ошибки = Новый Массив; Ид = Новый Структура;
Для Каждого К Из СтрРазделить("Орг,Кон,Вал,Т1,Т2,С1,С2,С3", ",") Цикл Ид.Вставить(К, Строка(Новый УникальныйИдентификатор)); КонецЦикла;
Орг = Справочники.Организации.НайтиПоНаименованию("ООО ""Товары""", Истина);
Кон = Справочники.Контрагенты.НайтиПоНаименованию("Магазин ""Продукты""", Истина);
Вал = Справочники.Валюты.НайтиПоНаименованию("Рубли", Истина);
Т1 = Справочники.Товары.НайтиПоРеквизиту("Артикул", "H987"); Т2 = Справочники.Товары.НайтиПоРеквизиту("Артикул", "Mol34");
Карта = Новый Структура("Организация,Контрагент,Валюта", Новый Структура("Ид,Ссылка", Ид.Орг, Орг), Новый Структура("Ид,Ссылка", Ид.Кон, Кон), Новый Структура("Ид,Ссылка", Ид.Вал, Вал));
Для Каждого КЗ Из Карта Цикл зсб_СопоставлениеОбъектов.ЗаписатьСоответствие(КЗ.Ключ, КЗ.Значение.Ид, КЗ.Значение.Ссылка, "тест"); КонецЦикла;
зсб_СопоставлениеОбъектов.ЗаписатьСоответствие("Номенклатура", Ид.Т1, Т1, "тест");
зсб_СопоставлениеОбъектов.ЗаписатьСоответствие("Номенклатура", Ид.Т2, Т2, "тест");
Шапка = "{""id"":""%1"",""number"":""ТСТ-%2"",""date"":""2026-11-01T10:00:00"",""deleted"":%3,"
 + """organization"":{""id"":""" + Ид.Орг + """,""name"":""о""},""customer"":{""id"":""" + Ид.Кон + """,""name"":""к""},"
 + """currency"":{""id"":""" + Ид.Вал + """,""name"":""руб"",""code"":""643""},""amount"":0,""goods"":[%4]}";
Строка1 = "{""lineNo"":1,""item"":{""id"":""" + Ид.Т1 + """,""name"":""х"",""article"":""""},""quantity"":%1,""price"":50,""sum"":%2}";
Строка2 = "{""lineNo"":2,""item"":{""id"":""" + Ид.Т2 + """,""name"":""м"",""article"":""""},""quantity"":1,""price"":80,""sum"":80}";
СтрокаНет = "{""lineNo"":1,""item"":{""id"":""" + Строка(Новый УникальныйИдентификатор) + """,""name"":""ЗСБ нет такого товара"",""article"":""""},""quantity"":1,""price"":1,""sum"":1}";
Файл = "{""format"":""bsp-invoices"",""version"":1,""createdAt"":""2026-11-06T00:00:00"",""invoices"":[%1]}";
Заказ = Неопределено; Заказ3 = Неопределено;
Попытка
	// (а) первая загрузка
	Р = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(СтрШаблон(Файл, СтрШаблон(Шапка, Ид.С1, "1", "false", СтрШаблон(Строка1, "2", "100") + "," + Строка2)));
	Заказ = зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", Ид.С1);
	Если Р.Загружено <> 1 Или Заказ = Неопределено Тогда Ошибки.Добавить("а: " + СтрСоединить(Р.Протокол, " / "));
	Иначе
		Если Заказ.Проведен Тогда Ошибки.Добавить("а: проведен"); КонецЕсли;
		Если Заказ.Товары.Количество() <> 2 Или Заказ.Товары[0].Товар <> Т1 Или Заказ.Товары[0].Количество <> 2 Или Заказ.Товары[0].Сумма <> 100 Тогда Ошибки.Добавить("а: товары"); КонецЕсли;
		Если Заказ.Организация <> Орг Или Заказ.Покупатель <> Кон Или Заказ.Валюта <> Вал Или Заказ.Дата <> Дата(2026, 11, 1, 10, 0, 0) Тогда Ошибки.Добавить("а: шапка"); КонецЕсли;
		Если Заказ.СостояниеЗаказа <> Перечисления.СостоянияЗаказов.Открыт Или Не ЗначениеЗаполнено(Заказ.Склад) Тогда Ошибки.Добавить("а: склад/состояние"); КонецЕсли;
		Если Заказ.ВидЦен <> Кон.ВидЦен Тогда Ошибки.Добавить("а: вид цен"); КонецЕсли;
		Если Заказ.Сумма <> 180 Тогда Ошибки.Добавить("а: сумма " + Заказ.Сумма); КонецЕсли;
		// (б) повтор с новым количеством; склад и состояние, измененные в УФ, сохраняются
		Об = Заказ.ПолучитьОбъект(); Об.Склад = Справочники.Склады.НайтиПоНаименованию("Малый", Истина); Об.СостояниеЗаказа = Перечисления.СостоянияЗаказов.ВРаботе; Об.Записать();
		Р = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(СтрШаблон(Файл, СтрШаблон(Шапка, Ид.С1, "1", "false", СтрШаблон(Строка1, "5", "250") + "," + Строка2)));
		Если Р.Обновлено <> 1 Или Р.Загружено <> 0 Тогда Ошибки.Добавить("б: " + СтрСоединить(Р.Протокол, " / ")); КонецЕсли;
		Если зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", Ид.С1) <> Заказ Тогда Ошибки.Добавить("б: другой заказ"); КонецЕсли;
		Если Заказ.Товары[0].Количество <> 5 Или Заказ.Товары.Количество() <> 2 Тогда Ошибки.Добавить("б: количество"); КонецЕсли;
		Если Заказ.Склад.Наименование <> "Малый" Или Заказ.СостояниеЗаказа <> Перечисления.СостоянияЗаказов.ВРаботе Тогда Ошибки.Добавить("б: склад/состояние перетерты"); КонецЕсли;
	КонецЕсли;
	// (в) два счета, у одного неизвестный товар
	Р = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(СтрШаблон(Файл, СтрШаблон(Шапка, Ид.С2, "2", "false", СтрокаНет) + "," + СтрШаблон(Шапка, Ид.С3, "3", "false", "")));
	Заказ3 = зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", Ид.С3);
	Если Р.Загружено <> 1 Или Р.Пропущено <> 1 Тогда Ошибки.Добавить("в: " + СтрСоединить(Р.Протокол, " / ")); КонецЕсли;
	Протокол = СтрСоединить(Р.Протокол, " / ");
	Если СтрНайти(Протокол, "ТСТ-2") = 0 Или СтрНайти(Протокол, "не найден") = 0 Тогда Ошибки.Добавить("в: протокол " + Протокол); КонецЕсли;
	Если зсб_СопоставлениеОбъектов.СсылкаПоИдентификатору("СчетНаОплату", Ид.С2) <> Неопределено Тогда Ошибки.Добавить("в: пропущенный счет записан"); КонецЕсли;
	// (д) счет без товаров — заказ с пустой ТЧ
	Если Заказ3 = Неопределено Или Заказ3.Товары.Количество() <> 0 Тогда Ошибки.Добавить("д: пустая ТЧ"); КонецЕсли;
	// (г) неверный формат
	Для Каждого Плохой Из СтрРазделить("{""format"":""x"",""version"":1,""invoices"":[]}|не json|{""format"":""bsp-invoices"",""version"":2,""invoices"":[]}", "|") Цикл
		Р = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(Плохой);
		Если Р.Протокол.Количество() = 0 Или СтрНайти(Р.Протокол[0], "Неверный формат файла") = 0 Или Р.Загружено + Р.Обновлено <> 0 Тогда Ошибки.Добавить("г: " + Плохой); КонецЕсли;
	КонецЦикла;
	// (е) пометка удаления
	Р = зсб_ЗагрузкаСчетов.ЗагрузитьИзJSON(СтрШаблон(Файл, СтрШаблон(Шапка, Ид.С1, "1", "true", Строка2)));
	Если Заказ <> Неопределено И Не Заказ.ПометкаУдаления Тогда Ошибки.Добавить("е: не помечен " + СтрСоединить(Р.Протокол, " / ")); КонецЕсли;
Исключение
	Ошибки.Добавить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
КонецПопытки;
// Уборка
Для Каждого КЗ Из Новый Структура("СчетНаОплату_1,СчетНаОплату_2,СчетНаОплату_3,Организация,Контрагент,Валюта,Номенклатура_1,Номенклатура_2",
	Ид.С1, Ид.С2, Ид.С3, Ид.Орг, Ид.Кон, Ид.Вал, Ид.Т1, Ид.Т2) Цикл
	Н = РегистрыСведений.зсб_СоответствияОбъектовБСП.СоздатьНаборЗаписей();
	Н.Отбор.ТипОбъекта.Установить(СтрРазделить(КЗ.Ключ, "_")[0]); Н.Отбор.ИдентификаторБСП.Установить(КЗ.Значение); Н.Записать();
КонецЦикла;
Если Заказ <> Неопределено Тогда Заказ.ПолучитьОбъект().Удалить(); КонецЕсли;
Если Заказ3 <> Неопределено Тогда Заказ3.ПолучитьОбъект().Удалить(); КонецЕсли;
Результат = ?(Ошибки.Количество() = 0, "OK", СтрСоединить(Ошибки, "; "));
